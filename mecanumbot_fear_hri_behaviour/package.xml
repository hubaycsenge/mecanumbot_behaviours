<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mecanumbot_fear_hri_behaviour</name>
  <version>0.0.0</version>
  <description>Fear HRI behaviour tree for Mecanumbot.</description>
  <maintainer email="fahradnamazov@gmail.com">Fahrad Namazov</maintainer>
  <license>Apache License 2.0</license>

  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>mecanumbot_msgs</exec_depend>
  <exec_depend>mecanumbot_bt_config</exec_depend>
  <exec_depend>mecanumbot_movement_behaviours</exec_depend>
  <exec_depend>py_trees</exec_depend>
  <exec_depend>py_trees_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
