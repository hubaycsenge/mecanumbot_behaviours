<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mecanumbot_fetch_behaviour</name>
  <version>0.0.0</version>
  <description>
    Fetch behaviour tree for Mecanumbot. The robot looks for a tennis ball by
    driving widening circles while sweeping its head up and down, drives to the
    ball the moment it sees one, checks it is on the floor rather than on a
    table or in a hand, closes its grabbers on it, then finds the first person
    it can see, drives to them, faces them and lets go. It runs no detector of
    its own -- the ball comes from mecanumbot_locate_detections, which places it
    from the fetch camera detector's bounding boxes.
  </description>
  <maintainer email="csengehubay@gmail.com">Csenge Hubay</maintainer>
  <license>Apache License 2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <!-- The located ball. A standard type: a labelled pose with a confidence is
       exactly what Detection3DArray carries, and the z is what tells a ball on
       the floor from a ball in somebody's hand. -->
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>mecanumbot_msgs</exec_depend>
  <!-- The behaviour libraries this package builds on: Approach and its nav2
       navigators, TurnToward, FindPeople, the pose and people trackers, the
       accessory commander, and the constants loader and tree runner. -->
  <exec_depend>mecanumbot_bt_config</exec_depend>
  <exec_depend>mecanumbot_movement_behaviours</exec_depend>
  <exec_depend>py_trees</exec_depend>
  <exec_depend>py_trees_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
