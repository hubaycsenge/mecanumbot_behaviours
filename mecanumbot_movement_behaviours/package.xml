<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mecanumbot_movement_behaviours</name>
  <version>0.0.0</version>
  <description>The movement half of the behaviour library: turning, approaching, driving a route and searching it, shared by every tree.</description>
  <maintainer email="csengehubay@gmail.com">temesi</maintainer>
  <license>Apache License 2.0</license>

  <exec_depend>mecanumbot_bt_config</exec_depend>
  <exec_depend>mecanumbot_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <!-- The route and approach behaviours drive Nav2 through its actions. -->
  <exec_depend>nav2_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
